---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
}

const {
  title = 'Pebble Junkies',
  description = 'The one-stop shop for classic and new Pebble smartwatches — timeline, repairs, apps, news, and community.',
  ogImage = '/images/Pebble_Time_2.jpg',
  ogType = 'website',
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL('https://pebblejunkies.com');
const pageTitle = title === 'Pebble Junkies' ? title : `${title} · Pebble Junkies`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonicalPath = path === '/' ? '/' : path;
const canonicalUrl = new URL(canonicalPath === '/' ? '/' : canonicalPath, site).href.replace(/\/$/, '') || site.origin;
const absoluteOgImage = ogImage.startsWith('http')
  ? ogImage
  : new URL(ogImage, site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site.origin}/#website`,
      name: 'Pebble Junkies',
      url: site.origin,
      description,
      inLanguage: 'en',
      publisher: { '@id': `${site.origin}/#organization` },
    },
    {
      '@type': 'Organization',
      '@id': `${site.origin}/#organization`,
      name: 'Pebble Junkies',
      url: site.origin,
      logo: new URL('/images/Logo_2.png', site).href,
      sameAs: [
        'https://www.facebook.com/groups/pebble.junkies/',
        'https://github.com/TechJeeper/PebbleJunkiesWebsite',
      ],
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: pageTitle,
      description,
      isPartOf: { '@id': `${site.origin}/#website` },
      primaryImageOfPage: absoluteOgImage,
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="Pebble, Pebble watch, Pebble Time 2, Pebble Round 2, Pebble 2 Duo, Rebble, Core Devices, smartwatch, repair, battery, timeline"
    />
    <meta name="author" content="Pebble Junkies" />
    <meta name="theme-color" content="#07090d" />
    <meta name="color-scheme" content="dark" />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}
    <meta name="googlebot" content="index, follow" />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Pebble Junkies News Pulse"
      href="/rss.xml"
    />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <!-- Open Graph -->
    <meta property="og:site_name" content="Pebble Junkies" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:secure_url" content={absoluteOgImage} />
    <meta property="og:image:alt" content={pageTitle} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:image:alt" content={pageTitle} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Manrope:wght@400;500;600;700&family=Syne:wght@600;700;800&display=swap"
      rel="stylesheet"
    />

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-VEE9X9YCN0"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-VEE9X9YCN0');
    </script>
    <script
      data-goatcounter="https://pebblejunkies.goatcounter.com/count"
      async
      src="https://gc.zgo.at/count.js"
    ></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>
    <div class="scroll-orbs" id="scroll-orbs" aria-hidden="true">
      <span class="orb-a"></span>
      <span class="orb-b"></span>
      <span class="orb-c"></span>
    </div>
    <div class="site-wrap">
      <header class="site-header" id="site-header">
        <div class="container nav-inner">
          <a class="brand" href="/">
            <img src="/images/Logo_2.png" alt="Pebble Junkies" width="220" height="40" />
          </a>
          <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-links" id="nav-toggle">
            Menu
          </button>
          <ul class="nav-links" id="nav-links">
            <li><a href="/watches" aria-current={path === '/watches' ? 'page' : undefined}>Watches</a></li>
            <li><a href="/timeline" aria-current={path === '/timeline' ? 'page' : undefined}>Timeline</a></li>
            <li><a href="/repair" aria-current={path === '/repair' ? 'page' : undefined}>Repair</a></li>
            <li><a href="/apps" aria-current={path === '/apps' ? 'page' : undefined}>Apps</a></li>
            <li><a href="/news" aria-current={path === '/news' ? 'page' : undefined}>News</a></li>
            <li><a href="/start" aria-current={path === '/start' ? 'page' : undefined}>Get Started</a></li>
            <li class="nav-sep" aria-hidden="true"></li>
            <li><a class="nav-secondary" href="/developers" aria-current={path === '/developers' ? 'page' : undefined}>Developers</a></li>
            <li><a class="nav-secondary" href="/community" aria-current={path === '/community' ? 'page' : undefined}>Community</a></li>
          </ul>
        </div>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="container">
          <div class="footer-grid">
            <div>
              <h4>Pebble Junkies</h4>
              <p class="muted">
                Community hub for every Pebble — Kickstarter classics through Time 2 and Round 2.
                Not affiliated with Core Devices or Rebble; we just keep the map of the universe.
              </p>
              <p class="muted" style="margin:0">
                Graphics heritage by Noam Asulin · Site reinvented 2026 by
                <a href="https://techjeeper.com" target="_blank" rel="noopener">TechJeeper Designs</a>
              </p>
            </div>
            <div>
              <h4>Explore</h4>
              <ul>
                <li><a href="/timeline">Interactive timeline</a></li>
                <li><a href="/watches">Watch catalog</a></li>
                <li><a href="/repair">Repair & parts</a></li>
                <li><a href="/apps">App guides</a></li>
                <li><a href="/news">News pulse</a></li>
                <li><a href="/submit">Submit news or information</a></li>
                <li><a href="/rss.xml">RSS feed</a></li>
              </ul>
            </div>
            <div>
              <h4>Official / ecosystem</h4>
              <ul>
                <li><a href="https://repebble.com/watch" target="_blank" rel="noopener">Buy new Pebbles</a></li>
                <li><a href="https://rebble.io/" target="_blank" rel="noopener">Rebble</a></li>
                <li><a href="https://apps.rebble.io/" target="_blank" rel="noopener">Appstore</a></li>
                <li><a href="https://developer.repebble.com/" target="_blank" rel="noopener">Developer docs</a></li>
                <li><a href="https://bsky.app/profile/ericmigi.com" target="_blank" rel="noopener">Eric on Bluesky</a></li>
              </ul>
            </div>
          </div>
          <div class="footer-bottom">
            <span>© {new Date().getFullYear()} Pebble Junkies</span>
            <span>pebblejunkies.com · GitHub Pages</span>
          </div>
        </div>
      </footer>
    </div>

    <script src="../scripts/scroll-motion.js"></script>
  </body>
</html>
