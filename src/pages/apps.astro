---
import BaseLayout from '../layouts/BaseLayout.astro';
import apps from '../data/apps.json';

function formatHearts(n: number) {
  if (n >= 1000) return `${(n / 1000).toFixed(n >= 10000 ? 0 : 1).replace(/\.0$/, '')}k`;
  return String(n);
}

/** rePebble store app pages live at /{uuid} — never /details/{uuid} (404). */
function storeHref(app: { id: string; href?: string }) {
  return `https://apps.repebble.com/${app.id}`;
}
---

<BaseLayout
  title="App Guides"
  description="Most Loved watchapps and watchfaces from the rePebble store — ranked, hearted, and summarized by Pebble Junkies."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Store charts · {apps.updatedAt}</p>
      <h1>Most Loved on the store</h1>
      <p>
        Live picks from the rePebble Appstore API — the same Most Loved collections the community actually
        installs. We add Junkies context; hearts and ranks come from the store.
      </p>
      <div class="btn-row" style="margin-top:1.25rem">
        {apps.stores.map((s) => (
          <a class="btn btn-ghost" href={s.href} target="_blank" rel="noopener">{s.label}</a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Watchapps & companions</p>
        <h2>Top apps</h2>
        <p>Utilities, remotes, games — the installs that survived a decade of shutdowns.</p>
      </div>
      <div class="app-card-grid">
        {apps.watchapps.map((app) => (
          <a class="app-card" href={storeHref(app)} target="_blank" rel="noopener">
            <div class="app-card-media">
              {app.image ? (
                <img src={app.image} alt="" loading="lazy" width="144" height="168" />
              ) : (
                <span class="app-card-fallback">{app.title.slice(0, 1)}</span>
              )}
              <span class="app-card-rank">#{app.rank}</span>
            </div>
            <div class="app-card-body">
              <div class="app-card-top">
                <h3>{app.title}</h3>
                <span class="app-card-hearts" title="Store hearts">♥ {formatHearts(app.hearts)}</span>
              </div>
              <p class="app-card-meta">
                <span>{app.author}</span>
                <span class="dot">·</span>
                <span>{app.category}</span>
              </p>
              <p class="app-card-desc">{app.description}</p>
              {app.platforms?.length ? (
                <p class="app-card-platforms mono">
                  {app.platforms.slice(0, 6).join(' · ')}
                  {app.platforms.length > 6 ? ' · …' : ''}
                </p>
              ) : null}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Watchfaces</p>
        <h2>Top faces</h2>
        <p>Legibility first — then weather, animation, and sheer Pebble personality.</p>
      </div>
      <div class="app-card-grid">
        {apps.watchfaces.map((app) => (
          <a class="app-card" href={storeHref(app)} target="_blank" rel="noopener">
            <div class="app-card-media">
              {app.image ? (
                <img src={app.image} alt="" loading="lazy" width="144" height="168" />
              ) : (
                <span class="app-card-fallback">{app.title.slice(0, 1)}</span>
              )}
              <span class="app-card-rank">#{app.rank}</span>
            </div>
            <div class="app-card-body">
              <div class="app-card-top">
                <h3>{app.title}</h3>
                <span class="app-card-hearts" title="Store hearts">♥ {formatHearts(app.hearts)}</span>
              </div>
              <p class="app-card-meta">
                <span>{app.author}</span>
                <span class="dot">·</span>
                <span>{app.category}</span>
              </p>
              <p class="app-card-desc">{app.description}</p>
              {app.platforms?.length ? (
                <p class="app-card-platforms mono">
                  {app.platforms.slice(0, 6).join(' · ')}
                  {app.platforms.length > 6 ? ' · …' : ''}
                </p>
              ) : null}
            </div>
          </a>
        ))}
      </div>

      <div class="panel" style="padding:1.5rem;margin-top:2.5rem">
        <h3 style="margin-top:0">Pro tips</h3>
        <ul>
          {apps.notes.map((n) => (
            <li class="muted" style="margin-bottom:0.55rem">{n}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
