---
import BaseLayout from '../layouts/BaseLayout.astro';
import apps from '../data/apps.json';

const formatHearts = (n: number) => n.toLocaleString('en-US');
---

<BaseLayout
  title="App Guides"
  description="Most Loved watchapps and watchfaces from the rePebble store — ranked, hearted, and summarized by Pebble Junkies."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Store pulse · {apps.updatedAt}</p>
      <h1>Most Loved right now</h1>
      <p>
        Live picks from the rePebble Appstore Most Loved charts — not paid placements, just real hearts
        from the community. Tap through to install; filter by your hardware in the store.
      </p>
      <div class="btn-row" style="margin-top:1.25rem">
        {apps.stores.map((s) => (
          <a class="btn btn-ghost" href={s.href} target="_blank" rel="noopener">{s.label}</a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Watchapps & companions</p>
        <h2>Top apps</h2>
        <p>Health trackers, media remotes, utilities, and the games we pretend we uninstalled.</p>
      </div>

      <div class="watch-grid">
        {apps.watchapps.map((app) => (
          <a class="watch-tile app-tile" href={app.href} target="_blank" rel="noopener">
            <div class="media">
              {app.image ? (
                <img src={app.image} alt="" loading="lazy" />
              ) : (
                <span class="muted">No preview</span>
              )}
            </div>
            <div class="body">
              <div class="top">
                <span class="pill pill-live">#{app.rank}</span>
                <span class="app-hearts" title="Store hearts">♥ {formatHearts(app.hearts)}</span>
              </div>
              <h3>{app.title}</h3>
              <p class="tagline">{app.author} · {app.category}</p>
              <p class="app-blurb">{app.description}</p>
              <ul class="watch-meta">
                <li>
                  <strong>Platforms</strong> {app.platforms.join(', ') || '—'}
                </li>
              </ul>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Watchfaces</p>
        <h2>Top faces</h2>
        <p>Weather monsters, typographic legends, and the animated faces that test your battery patience.</p>
      </div>

      <div class="watch-grid">
        {apps.watchfaces.map((face) => (
          <a class="watch-tile app-tile" href={face.href} target="_blank" rel="noopener">
            <div class="media">
              {face.image ? (
                <img src={face.image} alt="" loading="lazy" />
              ) : (
                <span class="muted">No preview</span>
              )}
            </div>
            <div class="body">
              <div class="top">
                <span class="pill pill-live">#{face.rank}</span>
                <span class="app-hearts" title="Store hearts">♥ {formatHearts(face.hearts)}</span>
              </div>
              <h3>{face.title}</h3>
              <p class="tagline">{face.author} · {face.category}</p>
              <p class="app-blurb">{face.description}</p>
              <ul class="watch-meta">
                <li>
                  <strong>Platforms</strong> {face.platforms.join(', ') || '—'}
                </li>
              </ul>
            </div>
          </a>
        ))}
      </div>

      <div class="panel" style="padding:1.5rem; margin-top:2.5rem">
        <h3 style="margin-top:0">Pro tips</h3>
        <ul>
          {apps.notes.map((n) => (
            <li class="muted" style="margin-bottom:0.55rem">{n}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
